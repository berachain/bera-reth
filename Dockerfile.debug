# Fast debug build Dockerfile for bera-reth development
FROM rust:1.83-slim AS debug-builder

WORKDIR /app

# Install system dependencies (minimal for debug)
RUN apt-get update && apt-get install -y \
    libclang-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

# Build debug version with minimal optimizations for speed
# --profile dev uses the default dev profile which is faster to compile
RUN cargo build --bin bera-reth

# Use Ubuntu as the runtime image
FROM ubuntu:24.04 AS debug-runtime

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y ca-certificates libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy the debug binary
COPY --from=debug-builder /app/target/debug/bera-reth /usr/local/bin/
RUN chmod +x /usr/local/bin/bera-reth

# Copy licenses
COPY LICENSE ./

# Expose standard Ethereum execution client ports  
EXPOSE 30303 30303/udp 9001 8545 8546 8551

# Set environment to show we're in debug mode
ENV RUST_LOG=debug
ENV BUILD_TYPE=debug

ENTRYPOINT ["/usr/local/bin/bera-reth"]